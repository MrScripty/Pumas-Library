# Attribution hashes must match native checkouts even with core.autocrlf=true.
rust/Cargo.lock text eol=lf
rust/**/Cargo.toml text eol=lf
pnpm-lock.yaml text eol=lf
electron/package.json text eol=lf
frontend/package.json text eol=lf

# Preserve verbatim third-party legal bytes, including mixed line endings.
scripts/release/licenses/* -text -whitespace
docs/release-attribution/**/THIRD-PARTY-NOTICES.txt -text -whitespace
# Archive-captured CPython license texts are evidence and must remain verbatim.
docs/plans/torch-cross-platform-runtime-management/reports/managed-python-license-collection/**/licenses/** -text -whitespace
