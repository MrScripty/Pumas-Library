+    def rename_info(self, artifact, directory):
+        def rename(members):
+            old = next(n.rsplit("/", 1)[0] for n in members if n.endswith(".dist-info/METADATA"))
+            renamed = {n.replace(old + "/", directory + "/", 1): body for n, body in members.items()}
+            record = directory + "/RECORD"
+            renamed[record] = renamed[record].replace(old.encode(), directory.encode())
+            members.clear()
+            members.update(renamed)
+        self.mutate(artifact, rename)
+
+    def test_simple_json_conformant_10_through_13_versions_lists(self):
+        for version in ("1.0", "1.1", "1.2", "1.3"):
+            with self.subTest(version=version):
+                request = self.request([self.torch()])
+                for observation in request["observations"]:
+                    page = json.loads(observation["body"])
+                    page["meta"]["api-version"] = version
+                    if version == "1.0":
+                        page.pop("versions")
+                    else:
+                        # Legacy strings/no-file versions are permitted and not ordered.
+                        page["versions"] += ["legacy-snapshot", "0.1"]
+                    observation["body"] = json.dumps(page)
+                self.assertEqual(len(owner.prepare(request, self.observation)["candidates"]), 1)
+
+    def test_simple_json_11_through_13_cannot_omit_versions(self):
+        for version in ("1.1", "1.2", "1.3"):
+            with self.subTest(version=version), self.assertRaises(owner.Refused):
+                request = self.request([self.torch()])
+                for observation in request["observations"]:
+                    page = json.loads(observation["body"])
+                    page["meta"]["api-version"] = version
+                    page.pop("versions")
+                    observation["body"] = json.dumps(page)
+                owner.prepare(request, self.observation)
+
+    def test_simple_versions_collection_and_wheel_association_are_checked(self):
+        for versions in (None, "2.14.0+cpu", [1], ["2.14.0+cpu", "2.14.0+cpu"], [], ["2.14.0"]):
+            with self.subTest(versions=versions), self.assertRaises(owner.Refused):
+                request = self.request([self.torch()])
+                page = json.loads(request["observations"][0]["body"])
+                page["versions"] = versions
+                request["observations"][0]["body"] = json.dumps(page)
+                owner.prepare(request, self.observation)
+
+    def test_actual_dist_info_wrong_name_version_or_nested_path_refuses(self):
+        for directory in ("wrong-1.0.dist-info", "torch-1.0.dist-info", "nested/torch-2.14.0+cpu.dist-info"):
+            with self.subTest(directory=directory):
+                shutil.rmtree(self.wheels)
+                self.wheels.mkdir()
+                artifact = self.torch()
+                self.rename_info(artifact, directory)
+                request = self.request([artifact])
+                # Conformant 1.0 isolates the wheel gap on the frozen parser too.
+                for observation in request["observations"]:
+                    page = json.loads(observation["body"])
+                    page["meta"]["api-version"] = "1.0"
+                    page.pop("versions")
+                    observation["body"] = json.dumps(page)
+                with self.assertRaises(owner.Refused):
+                    self.inspect(request, [artifact])
+
