{
  "name": "pumas-library-electron",
  "version": "0.7.0",
  "description": "Electron wrapper for Pumas Library",
  "main": "dist/main.js",
  "author": "Pumas Library Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrScripty/Pumas-Library.git"
  },
  "scripts": {
    "generate:desktop-contract": "node scripts/generate-desktop-contract.mjs",
    "check:desktop-contract": "node scripts/generate-desktop-contract.mjs --check",
    "test:desktop-contract-generator": "node scripts/generate-desktop-contract.test.mjs",
    "test:desktop-contract-conformance": "node scripts/with-desktop-contract-fixtures.mjs node scripts/desktop-contract-conformance.test.mjs",
    "validate": "tsc --noEmit",
    "build": "tsc && node scripts/bundle-preload.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "watch": "tsc -w",
    "start": "npm run build && electron .",
    "run:launcher-release": "electron .",
    "run:launcher-release-ci-smoke": "electron --no-sandbox --disable-setuid-sandbox --disable-dev-shm-usage --disable-gpu .",
    "dev": "npm run build && electron . --dev",
    "clean": "rm -rf dist",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "package": "npm run build && electron-builder",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "cd ../frontend && npm run build && cd ../electron && npm run build && electron-builder --win",
    "package:mac": "cd ../frontend && npm run build && cd ../electron && npm run build && electron-builder --mac"
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.4",
    "ajv": "8.20.0",
    "electron": "43.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.58.1"
  },
  "build": {
    "appId": "com.pumas.library",
    "productName": "Pumas Library",
    "icon": "build/icons/Pumas-Library_05.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/bin",
        "to": ".",
        "filter": [
          "pumas-rpc",
          "pumas-rpc.exe",
          "*.dll",
          "*.so",
          "*.so.*",
          "*.dylib"
        ]
      },
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "Pumas-Library_05.png",
          "icon.ico",
          "icon.icns"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/Pumas-Library_05.png",
      "category": "Development",
      "maintainer": "Pumas Library Team"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons/icon.ico",
      "signtoolOptions": {
        "publisherName": "Pumas Library Team"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pumas Library",
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "artifactName": "Pumas.Library.Setup.${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "appImage": {
      "artifactName": "Pumas.Library-${version}.${ext}"
    },
    "deb": {
      "artifactName": "pumas-library-electron_${version}_amd64.${ext}"
    },
    "portable": {
      "artifactName": "Pumas.Library.${version}.${ext}"
    },
    "dmg": {
      "artifactName": "Pumas.Library-${version}-arm64.${ext}"
    }
  }
}
