{
  "name": "pumas-library-frontend",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:library-only": "vite build --mode library-only",
    "preview": "vite preview",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:desktop-contract": "node ../electron/scripts/with-desktop-contract-fixtures.mjs pnpm exec vitest run --config vitest.conformance.config.ts",
    "test:coverage": "vitest run --coverage",
    "check:types": "tsc --noEmit"
  },
  "dependencies": {
    "@react-aria/interactions": "^3.28.1",
    "framer-motion": "^12.43.0",
    "loglevel": "^1.9.2",
    "lucide-react": "^0.561.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "autoprefixer": "^10.6.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "27.4.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.58.1",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
